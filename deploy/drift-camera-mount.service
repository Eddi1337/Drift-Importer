[Unit]
Description=Mount the Drift camera card
BindsTo=dev-drift\x2dcamera.device
After=dev-drift\x2dcamera.device
ConditionPathExists=/dev/drift-camera

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/drift-camera-mount
# Detach a removed card even if a scanner still has an old file open. New
# readers then see an empty mountpoint until the next camera connection.
ExecStop=/usr/bin/umount -l /media/drift-camera
TimeoutStartSec=30
TimeoutStopSec=15
